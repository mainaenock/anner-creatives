{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anner-creatives",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anner-creatives-db",
      "database_id": "441dc17e-35e9-416b-a100-daa0990d0e88",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "anner-creatives-products"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
