{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anner-creatives",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ADMIN_ACCESS_TEAM_DOMAIN": "https://young-darkness-17fd.cloudflareaccess.com",
    "ADMIN_ACCESS_AUDIENCE": "073afe16cebcc151d1eb72aac16368ef2e605960185aec51ab5dd44da689d399",
    "ADMIN_EMAIL": "annercreativeske@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anner-creatives-db",
      "database_id": "441dc17e-35e9-416b-a100-daa0990d0e88",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "anner-creatives-products"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
